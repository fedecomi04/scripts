# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Nerfstudio + our pipeline output dirs (we suppress writes but keep this
# in case something slips through — see dynamic_gs/__init__.py)
outputs/

# Third-party vendored code: huge, not authored here, install from upstream
third_party/

# Local checkpoints + IDE state
checkpoints/
.codex
.codex/

# One-off visualization HTML / debug PNGs the user generated but didn't intend
# to commit. Concrete tracked plots go elsewhere (e.g. inside the dataset dir).
visualization/

# Per-dataset run dirs end up under data_teleoperation/datasets/<name>/ which is
# outside this repo, but in case anyone symlinks or copies a dataset into the
# repo root, don't accidentally commit it.
data_teleoperation/

# Tooling (none currently kept committed)
.idea/
.vscode/

# experiments/ — local-only scratch (prototypes, benches, large PLY/weight
# outputs). Not version-controlled; previously-tracked scripts were untracked
# via `git rm --cached`.
experiments/

# Model weights (large binaries; e.g. weights/clip/ViT-B-32.pt is 338 MB —
# over GitHub's 100 MB limit). Fetch from upstream, don't commit.
weights/
RenderOption_*.json

# Transient probe/run logs + a large scratch frame dump (45 MB) — regenerated,
# not version-controlled.
_probe_*.log
rewrite_spec/_resume_*.log
real_hw/frame_dump/

# Test datasets are hosted externally (Google Drive) — too heavy for git.
# Ignore the per-dataset data dirs; keep datasets/README.md (download links + prompts).
dynamic_gs2/datasets/*/
